{
  "user_agent": "cache-flow-collector/1.0 (personal job search; GitHub Actions; low request rate)",
  "http": {
    "minDelayMs": 700,
    "maxDelayMs": 1800,
    "concurrency": 6,
    "timeoutMs": 25000,
    "retries": 3
  },
  "store_non_us": false,
  "history_days": 21,
  "greenhouse_pay_transparency": true,
  "greenhouse_pay_cap_per_board": 5,
  "max_per_query": 200,
  "detail_cap_per_source": 60,
  "aggregators": {
    "queries": [
      "product marketing security",
      "product manager security",
      "threat intelligence",
      "security researcher",
      "go-to-market strategy",
      "partnerships alliances",
      "chief of staff technology",
      "competitive intelligence",
      "sales enablement director",
      "strategic initiatives technology",
      "security sales strategy",
      "business operations director"
    ],
    "where": "New York, NY",
    "maxDays": 7,
    "serpMaxQueries": 6
  },
  "host_rules": [
    {
      "suffix": "myworkdayjobs.com",
      "transport": "node",
      "minDelayMs": 8000,
      "maxDelayMs": 12000,
      "retries": 5,
      "backoffMs": 10000,
      "_note": "Workday-specific client. One active request per Workday tenant (requests queue per host), 8-12s apart. Transport: Node's built-in https.request instead of fetch(), with the same honest user agent and headers (Workday's Cloudflare layer was reported in Nov 2026 to challenge fetch() but not https.request). A Cloudflare challenge (cf-mitigated) is never retried; a plain 429 honors Retry-After with bounded backoff. Failed scans keep previous roles."
    },
    {
      "suffix": "boards-api.greenhouse.io",
      "minDelayMs": 500,
      "maxDelayMs": 1100
    },
    {
      "suffix": "apply.careers.microsoft.com",
      "minDelayMs": 7000,
      "maxDelayMs": 12000,
      "retries": 5,
      "backoffMs": 10000,
      "_note": "Eightfold PCSX pagination returned 429 in testing; start with 5-10s gaps"
    },
    {
      "suffix": "careers.cisco.com",
      "minDelayMs": 1500,
      "maxDelayMs": 3000,
      "retries": 4,
      "backoffMs": 5000
    },
    {
      "suffix": "google.com",
      "minDelayMs": 3000,
      "maxDelayMs": 6000,
      "retries": 2,
      "backoffMs": 20000
    },
    {
      "suffix": "jobs.paloaltonetworks.com",
      "minDelayMs": 3000,
      "maxDelayMs": 6000,
      "retries": 2,
      "backoffMs": 30000
    }
  ],
  "workday_max_per_query": 60,
  "eightfold_max_per_query": 30,
  "phenom_max_per_query": 30,
  "workday_detail_cap": 40,
  "workday_query_rotation": 3,
  "workday_rotate_min_queries": 7,
  "rotation_close_hours": 74,
  "eightfold_scan_pages_per_run": 40,
  "seed_probe_batch": 40
}